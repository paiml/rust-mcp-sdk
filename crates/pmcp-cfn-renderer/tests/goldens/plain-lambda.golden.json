{
  "descriptor_toml": "[target]\ntype = \"pmcp-run\"\nversion = \"1.0.0\"\n\n[aws]\nregion = \"us-east-1\"\n\n[server]\nname = \"plain-lambda-fixture\"\nmemory_mb = 512\ntimeout_seconds = 30\n\n[environment]\nRUST_LOG = \"info\"\n\n[secrets]\n\n[auth]\nenabled = false\nprovider = \"none\"\ncallback_urls = []\n\n[auth.dcr]\nenabled = true\npublic_client_patterns = [\n    \"claude\",\n    \"desktop\",\n    \"cursor\",\n    \"mcp-inspector\",\n    \"chatgpt\",\n]\ndefault_scopes = [\n    \"openid\",\n    \"email\",\n    \"mcp/read\",\n]\nallowed_scopes = [\n    \"openid\",\n    \"email\",\n    \"profile\",\n    \"mcp/read\",\n    \"mcp/write\",\n]\n\n[auth.scopes.custom]\n\n[observability]\nlog_retention_days = 30\nenable_xray = true\ncreate_dashboard = true\n\n[observability.alarms]\nerror_threshold = 10\nlatency_threshold_ms = 5000\n\n[assets]\ninclude = []\nexclude = [\n    \"**/*.tmp\",\n    \"**/.DS_Store\",\n    \"**/Thumbs.db\",\n]\n\n[composition]\ntier = \"foundation\"\nallow_composition = true\ninternal_only = false",
  "params": {
    "account_id": "123456789012",
    "region": "us-east-1",
    "stack_name": "plain-lambda-fixture-stack",
    "artifact": {
      "s3_bucket": "pmcp-deploy-123456789012-us-east-1",
      "s3_key": "plain-lambda-fixture/bootstrap.zip"
    },
    "environment": {
      "RUST_LOG": "info"
    },
    "metadata": {
      "version": "1.0.0",
      "snapshot_baked": false
    }
  },
  "normalized": {
    "Description": "MCP Server: plain-lambda-fixture",
    "Outputs": {
      "ApiUrl": {
        "Description": "MCP endpoint (construct from deployment ID)",
        "Value": "https://api.pmcp.run/{use-deployment-id}/mcp"
      },
      "DashboardUrl": {
        "Description": "CloudWatch Console",
        "Value": "https://console.aws.amazon.com/cloudwatch/home?region=us-east-1"
      },
      "LambdaArn": {
        "Description": "MCP Server Lambda ARN",
        "Value": {
          "Fn::GetAtt": [
            "Function-0",
            "Arn"
          ]
        }
      },
      "LambdaName": {
        "Description": "MCP Server Lambda Name",
        "Value": {
          "Ref": "Function-0"
        }
      },
      "McpRoleArn": {
        "Description": "MCP Server Lambda execution role ARN (stable export for downstream stacks)",
        "Export": {
          "Name": "pmcp-plain-lambda-fixture-McpRoleArn"
        },
        "Value": {
          "Fn::GetAtt": [
            "Role-0",
            "Arn"
          ]
        }
      }
    },
    "Resources": {
      "Function-0": {
        "DependsOn": [
          "Policy-0",
          "Role-0"
        ],
        "Properties": {
          "Architectures": [
            "arm64"
          ],
          "Code": {
            "S3Bucket": "<artifact>",
            "S3Key": "<artifact>"
          },
          "Environment": {
            "Variables": {
              "MCP_SERVERS_TABLE": "McpServer",
              "PMCP_ORGANIZATION_ID": "default-org",
              "PMCP_SERVER_ID": "plain-lambda-fixture",
              "RUST_LOG": "info"
            }
          },
          "FunctionName": "plain-lambda-fixture",
          "Handler": "bootstrap",
          "LoggingConfig": {
            "LogFormat": "JSON"
          },
          "MemorySize": 256,
          "Role": {
            "Fn::GetAtt": [
              "Role-0",
              "Arn"
            ]
          },
          "Runtime": "provided.al2023",
          "Tags": [
            {
              "Key": "managed-by",
              "Value": "pmcp"
            },
            {
              "Key": "project",
              "Value": "hosting"
            },
            {
              "Key": "service",
              "Value": "plain-lambda-fixture"
            },
            {
              "Key": "target",
              "Value": "pmcp-run"
            }
          ],
          "Timeout": 30,
          "TracingConfig": {
            "Mode": "Active"
          }
        },
        "Type": "AWS::Lambda::Function"
      },
      "LogGroup-0": {
        "Properties": {
          "LogGroupName": {
            "Fn::Join": [
              "",
              [
                "/aws/lambda/",
                {
                  "Ref": "Function-0"
                }
              ]
            ]
          },
          "RetentionInDays": 7,
          "Tags": [
            {
              "Key": "managed-by",
              "Value": "pmcp"
            },
            {
              "Key": "project",
              "Value": "hosting"
            },
            {
              "Key": "service",
              "Value": "plain-lambda-fixture"
            },
            {
              "Key": "target",
              "Value": "pmcp-run"
            }
          ]
        },
        "Type": "AWS::Logs::LogGroup"
      },
      "Policy-0": {
        "Properties": {
          "PolicyDocument": {
            "Statement": [
              {
                "Action": [
                  "xray:PutTraceSegments",
                  "xray:PutTelemetryRecords"
                ],
                "Effect": "Allow",
                "Resource": "*"
              },
              {
                "Action": [
                  "dynamodb:GetItem",
                  "dynamodb:Query"
                ],
                "Effect": "Allow",
                "Resource": [
                  "arn:aws:dynamodb:<region>:<account>:table/McpServer",
                  "arn:aws:dynamodb:<region>:<account>:table/McpServer/*"
                ]
              },
              {
                "Action": "lambda:InvokeFunction",
                "Effect": "Allow",
                "Resource": "arn:aws:lambda:<region>:<account>:function:*"
              }
            ],
            "Version": "2012-10-17"
          },
          "PolicyName": "<policy-name>",
          "Roles": [
            {
              "Ref": "Role-0"
            }
          ]
        },
        "Type": "AWS::IAM::Policy"
      },
      "Role-0": {
        "Properties": {
          "AssumeRolePolicyDocument": {
            "Statement": [
              {
                "Action": "sts:AssumeRole",
                "Effect": "Allow",
                "Principal": {
                  "Service": "lambda.amazonaws.com"
                }
              }
            ],
            "Version": "2012-10-17"
          },
          "ManagedPolicyArns": [
            {
              "Fn::Join": [
                "",
                [
                  "arn:",
                  {
                    "Ref": "AWS::Partition"
                  },
                  ":iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
                ]
              ]
            }
          ],
          "Tags": [
            {
              "Key": "managed-by",
              "Value": "pmcp"
            },
            {
              "Key": "project",
              "Value": "hosting"
            },
            {
              "Key": "service",
              "Value": "plain-lambda-fixture"
            },
            {
              "Key": "target",
              "Value": "pmcp-run"
            }
          ]
        },
        "Type": "AWS::IAM::Role"
      }
    }
  }
}
